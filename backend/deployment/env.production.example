# Django
DEBUG=False
ENVIRONMENT=production
SECRET_KEY=replace-with-a-long-random-secret
DJANGO_SETTINGS_MODULE=core.prod_settings

# Database
USE_POSTGRES=True
DB_NAME=handy_pos_db
DB_USER=handy_pos_db_user
DB_PASSWORD=replace-with-a-strong-db-password
DB_HOST=127.0.0.1
DB_PORT=5432
DB_SSLMODE=prefer
DB_CONN_MAX_AGE=60

# Hosts and browser security
ALLOWED_HOSTS=api.handypos.online,menu.handypos.online
CORS_ALLOWED_ORIGINS=https://app.handypos.online
CSRF_TRUSTED_ORIGINS=https://api.handypos.online,https://menu.handypos.online,https://app.handypos.online

# Payments / PayChangu hosted checkout
PAYMENT_PUBLIC_BASE_URL=https://api.handypos.online

# Customer-facing QR menu origin
PUBLIC_MENU_BASE_URL=https://menu.handypos.online

# Logging
DJANGO_LOG_LEVEL=INFO

# Email
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=noreply@example.com

# Redis / Celery (optional)
CELERY_BROKER_URL=redis://127.0.0.1:6379/0
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/0

# MRA EIS
MRA_EIS_MODE=TEST
MRA_EIS_BASE_URL=https://dev-eis-api.mra.mw
MRA_EIS_TIMEOUT_SECONDS=30
MRA_EIS_VERIFY_SSL=True
MRA_EIS_ACCESS_KEY=
MRA_EIS_SECRET_KEY=
# Independent secret used to encrypt each activated terminal's MRA credentials.
# Keep it stable after activation; rotating it requires a planned credential migration.
MRA_EIS_CREDENTIAL_ENCRYPTION_KEY=replace-with-a-long-random-secret
MRA_EIS_PRODUCT_ID=HandyPOS
MRA_EIS_DRY_RUN=True
MRA_EIS_ENABLE_HTTP_CALLS=True
MRA_EIS_ALLOW_LIVE_SUBMISSION=False
MRA_EIS_REQUIRE_LOCAL_TAC=False
MRA_EIS_STRICT_PRODUCT_CODES=False
MRA_EIS_DEFAULT_CURRENCY=MWK
MRA_EIS_CONFIG_MAX_AGE_HOURS=24
MRA_EIS_REQUIRE_FRESH_CONFIG_FOR_SALES=True
MRA_EIS_REQUIRE_OFFLINE_REPLAY_SEQUENCE_GUARD=True
MRA_EIS_ENFORCE_TERMINAL_DEVICE_BINDING=True
MRA_EIS_SERVER_TIME_MAX_AGE_HOURS=24
MRA_EIS_MESSAGE_HASH_INPUT_MODE=canonical_json
MRA_EIS_MESSAGE_HASH_INPUT_CONFIRMED_BY_MRA=False
MRA_EIS_RECORD_MESSAGE_HASH_EVIDENCE=True
MRA_EIS_LOG_MESSAGE_HASH_INPUT=False

# Monitoring (optional)
SENTRY_DSN=
